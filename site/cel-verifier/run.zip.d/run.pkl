import "run:context" as c
import "graalvm.pkl" as jdk
ver = c.ver ?? "0.14.0"

// The fat JAR. Only lock versions of the CEL verifier that we know about. Otherwise accept anything.
jar {
  hashes = new Mapping<String, String> {
    ["0.14.0"] = "25dae07dedab8b5997c3f08b798ce432ed8115bd8e782630c2db4dfaff064c2b"
  }
  lock = if (hashes.containsKey(ver)) "#sha256=\(hashes[ver])" else ""
  path = "https://repo1.maven.org/maven2/dev/cel/verifier-cli/\(ver)/verifier-cli-\(ver).jar" + lock
}

urls {
  java = jdk.path
  verifier = jar.path
}

executable = c.resolved.java
arguments = List(
    "--sun-misc-unsafe-memory-access=allow",
    "--enable-native-access=ALL-UNNAMED",
    "-jar", c.resolved.verifier,
) + c.args
